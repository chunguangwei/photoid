<?xml version="1.0" encoding="utf-8"?>
<!--
  原生闪屏（点击图标 → Flutter 引擎绘制首帧之间的这一瞬）。

  必须与 SplashPage 的背景渐变一致。默认模板给的是纯白，而启动页是深蓝紫，
  于是点图标会先白闪一下再突然变深色，那一下跳变足以毁掉整段动画的质感。
  这里无法做动效（引擎还没起来），只能把静态首帧对齐。

  色值对应 lib/pages/splash_page.dart 的 _BackdropPainter._stops，
  Android 的 gradient 只支持三段，故取首/中/尾。改一处记得改另一处。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#7E97DE"
                android:centerColor="#3C4C82"
                android:endColor="#27325A" />
        </shape>
    </item>
</layer-list>
